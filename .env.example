# Copy to .env for local use. Never commit the real .env file.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ADMIN_KEY=replace-me-with-another-random-string
DATABASE_URL=sqlite:///./data/wallet.db
ENABLE_CHAOS=false
