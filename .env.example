# App secrets (placeholders only, never commit real values)
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ADMIN_KEY=replace-me-with-another-random-string
ENABLE_CHAOS=false

# Postgres (used by docker compose)
POSTGRES_USER=wallet
POSTGRES_PASSWORD=replace-me-with-a-simple-password
POSTGRES_DB=wallet

# Only for running without Docker (local SQLite). Compose overrides this.
# DATABASE_URL=sqlite:///./data/wallet.db
